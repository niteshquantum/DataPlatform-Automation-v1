pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    parameters {
        choice(
            name: 'SOURCE_DATABASE',
            choices: ['MSSQL', 'MYSQL', 'POSTGRESQL'],
            description: 'Source Database Type'
        )
        choice(
            name: 'DESTINATION_DATABASE',
            choices: ['MSSQL', 'MYSQL', 'POSTGRESQL'],
            description: 'Destination Database Type'
        )
        string(
            name: 'SOURCE_HOST',
            defaultValue: '',
            description: 'Optional override. Leave empty to use selected database config.'
        )
        string(
            name: 'SOURCE_PORT',
            defaultValue: '',
            description: 'Optional override. Leave empty to use selected database config.'
        )
        string(
            name: 'SOURCE_DB',
            defaultValue: '',
            description: 'Optional override. Leave empty to use selected database config.'
        )
        string(
            name: 'SOURCE_SCHEMA',
            defaultValue: '',
            description: 'Optional override. Leave empty to use selected database config.'
        )
        string(
            name: 'SOURCE_USER',
            defaultValue: '',
            description: 'Optional override. Leave empty to use selected database config.'
        )
        password(
            name: 'SOURCE_PASSWORD',
            defaultValue: '',
            description: 'Optional override. Leave empty to use selected database config.'
        )
        string(
            name: 'DESTINATION_HOST',
            defaultValue: '',
            description: 'Optional override. Leave empty to use selected database config.'
        )
        string(
            name: 'DESTINATION_PORT',
            defaultValue: '',
            description: 'Optional override. Leave empty to use selected database config.'
        )
        string(
            name: 'DESTINATION_DB',
            defaultValue: '',
            description: 'Optional override. Leave empty to use selected database config.'
        )
        string(
            name: 'DESTINATION_SCHEMA',
            defaultValue: '',
            description: 'Optional override. Leave empty to use selected database config.'
        )
        string(
            name: 'DESTINATION_USER',
            defaultValue: '',
            description: 'Optional override. Leave empty to use selected database config.'
        )
        password(
            name: 'DESTINATION_PASSWORD',
            defaultValue: '',
            description: 'Optional override. Leave empty to use selected database config.'
        )
    }

    stages {
        stage('Initialize Migration') {
            steps {
                checkout scm
                bat 'scripts\\batch\\migration\\windows\\initialize_migration.bat'
            }
        }
        stage('Validate Source') {
            steps {
                
                bat 'scripts\\batch\\migration\\windows\\validate_source.bat'
            }
        }
        stage('Validate Destination') {
            steps {
                
                bat 'scripts\\batch\\migration\\windows\\validate_destination.bat'
            }
        }
        stage('Extract Source Schema') {
            steps {
                
                bat 'scripts\\batch\\migration\\windows\\extract_schema.bat'
            }
        }
        stage('Generate Target DDL') {
            steps {
                
                bat 'scripts\\batch\\migration\\windows\\generate_ddl.bat'
            }
        }

        stage('Install Liquibase') {
            steps {
                
                bat 'scripts\\batch\\common\\install_liquibase.bat'
            }
        }

        stage('Apply Schema') {
            steps {
                
                bat 'scripts\\batch\\migration\\windows\\apply_schema.bat'
            }
        }
    }

    post {
        success {
            echo "MIGRATION COMPLETED SUCCESSFULLY"
        }
        failure {
            echo "MIGRATION FAILED"
        }
        always {
            echo 'MIGRATION COMPLETED'
        }
    }
}
