/*
============================================================
COMMON LOGGING AND REPORTING FUNCTION
============================================================
*/

def executePipeline(
    String database,
    String action,
    String operatingSystem,
    Closure executionBody
) {

    def finalStatus = 'SUCCESS'
    def originalError = null
    def loggingInitialized = false

    try {

        /*
        ============================================================
        RBAC AUTHENTICATION
        ============================================================
        */

        def permission = "${database}.${action}".toLowerCase()

        echo "RBAC Permission : ${permission}"

        def authResult

        if (isUnix()) {

            authResult = sh(
                script: """
                    python3 rbac/auth_cli.py \
                        --username "${params.USERNAME}" \
                        --password "${params.PASSWORD}"
                """,
                returnStdout: true
            ).trim()

        } else {

            authResult = bat(
                script: """
                    @echo off
                    python rbac\\auth_cli.py ^
                        --username "${params.USERNAME}" ^
                        --password "${params.PASSWORD}"
                """,
                returnStdout: true
            ).trim()
        }

        def role = authResult.readLines().last().trim()

        echo "Logged in Role : ${role}"

        if (role.equalsIgnoreCase("Viewer")) {

            echo "=========================================="
            echo "Viewer Role Detected"
            echo "Publishing Executive Report"
            echo "=========================================="

		if (action == "load") {
		
		    publishHTML([
		        allowMissing: true,
		        alwaysLinkToLastBuild: true,
		        keepAll: true,
		        reportDir: "reports/migration/${database}",
		        reportFiles: "executive_report.html",
		        reportName: "${database.toUpperCase()} Executive Report"
		    ])
		
		}

            return
        }

        /*
        ============================================================
        RBAC AUTHORIZATION
        ============================================================
        */

        if (isUnix()) {

            sh """
                python3 rbac/cli.py \
                    --username "${params.USERNAME}" \
                    --password "${params.PASSWORD}" \
                    --permission "${permission}"
            """

        } else {

            bat """
                @echo off
                python rbac\\cli.py ^
                    --username "${params.USERNAME}" ^
                    --password "${params.PASSWORD}" ^
                    --permission "${permission}"
            """
        }

        /*
        ============================================================
        INITIALIZE LOGGING
        ============================================================
        
        */

        if (isUnix()) {

            sh """
                python3 scripts/logging/logger.py init \
                    --database "${database}" \
                    --action "${action}" \
                    --os "${operatingSystem}" \
                    --build-number "${env.BUILD_NUMBER}" \
                    --job-name "${env.JOB_NAME}" \
                    --build-url "${env.BUILD_URL}"
            """

        } else {

            bat """
                python scripts\\logging\\logger.py init ^
                    --database "${database}" ^
                    --action "${action}" ^
                    --os "${operatingSystem}" ^
                    --build-number "${env.BUILD_NUMBER}" ^
                    --job-name "${env.JOB_NAME}" ^
                    --build-url "${env.BUILD_URL}"
            """
        }

        loggingInitialized = true

        /*
        ============================================================
        EXECUTE ORIGINAL PIPELINE FLOW
        ============================================================
        */

        executionBody()

    } catch (Exception error) {

        finalStatus = 'FAILURE'
        originalError = error

    } finally {

        /*
        ============================================================
        FINALIZE LOGGING
        ============================================================
        */

        if (loggingInitialized) {

            try {

                if (isUnix()) {

                    sh """
                        python3 scripts/logging/logger.py finalize \
                            --database "${database}" \
                            --action "${action}" \
                            --build-number "${env.BUILD_NUMBER}" \
                            --status "${finalStatus}"
                    """

                } else {

                    bat """
                        python scripts\\logging\\logger.py finalize ^
                            --database "${database}" ^
                            --action "${action}" ^
                            --build-number "${env.BUILD_NUMBER}" ^
                            --status "${finalStatus}"
                    """
                }

            } catch (Exception finalizeError) {

                echo "WARNING: Logging finalization failed: ${finalizeError}"
            }

            /*
            ============================================================
            GENERATE REPORT
            ============================================================
            */

            try {

                if (isUnix()) {

                    sh """
                        python3 scripts/reporting/generate_report.py \
                            --database "${database}" \
                            --action "${action}" \
                            --build-number "${env.BUILD_NUMBER}"
                    """

                    sh """
                        python3 scripts/reporting/generate_history.py \
                            --database "${database}" \
                            --action "${action}" \
                            --build-number "${env.BUILD_NUMBER}"
                    """

                } else {

                    bat """
                        python scripts\\reporting\\generate_report.py ^
                            --database "${database}" ^
                            --action "${action}" ^
                            --build-number "${env.BUILD_NUMBER}"
                    """

                    bat """
                        python scripts\\reporting\\generate_history.py ^
                            --database "${database}" ^
                            --action "${action}" ^
                            --build-number "${env.BUILD_NUMBER}"
                    """
                }

            } catch (Exception reportError) {

                echo "WARNING: Report generation failed: ${reportError}"
            }

            /*
            ============================================================
            ARCHIVE LOGS AND REPORTS
            ============================================================
            */

            try {

                archiveArtifacts(
                    artifacts:
                        "logs/${database}/${action}/build_${env.BUILD_NUMBER}/**," +
                        "reports/${database}/${action}/build_${env.BUILD_NUMBER}/**," +
                        "reports/history/**," +
                        "reports/migration/${database}/**," +
                        "outputs/assessments/${database}/**," +
                        "outputs/assessments/assessment_report.json," +
                        "metadata/profiling/${database}/**," +
                        "metadata/reconciliation/${database}/**," +
                        "metadata/discovery/${database}/**," +
                        "metadata/assessment/${database}/**," +
                        "metadata/recommendation/${database}/**," +
                        "metadata/governance/${database}/**",
                    fingerprint: true,
                    allowEmptyArchive: true
                )
                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: "reports/migration/${database}",
                    reportFiles: "executive_report.html",
                    reportName: "${database.toUpperCase()} Executive Report"
                ])

            } catch (Exception archiveError) {

                echo "WARNING: Artifact archiving failed: ${archiveError}"
            }
        }
    }

    /*
    ============================================================
    RESTORE ORIGINAL PIPELINE FAILURE
    ============================================================
    */

    if (originalError != null) {
        throw originalError
    }
}

pipeline {

    agent none

    options {
        disableConcurrentBuilds()
    }

    parameters {
        choice(name: 'DATABASE', choices: ['MYSQL', 'POSTGRESQL', 'MONGODB', 'MSSQL'], description: 'Select Database')
        choice(name: 'ACTION', choices: ['SETUP', 'LOAD', 'CLEANUP'], description: 'Select Action')
        choice(name: 'CLEANUP_MODE', choices: ['PRESERVE_DATA', 'DELETE_DATA'], description: 'Select cleanup mode when ACTION is CLEANUP')
        string(name: 'USERNAME', defaultValue: '', description: 'RBAC Username')
        password(name: 'PASSWORD', defaultValue: '', description: 'RBAC Password')
    }

    stages {
        stage('Resolve Pipeline Route') {
            agent any
            steps {
                checkout scm
                script {
                    def configuration = load 'jenkins/pipeline_config.groovy'
                    def route = configuration.resolve(params.DATABASE, params.ACTION)

                    env.ROUTED_DATABASE = params.DATABASE.toLowerCase()
                    env.ROUTED_ACTION = params.ACTION.toLowerCase()
                    env.ROUTED_NODE = route.node
                    env.ROUTED_OS = route.os
                    env.ROUTED_PIPELINE = route.path

                    if (!fileExists(env.ROUTED_PIPELINE)) {
                        error "Configured pipeline module does not exist: ${env.ROUTED_PIPELINE}"
                    }

                    echo "DATABASE      : ${params.DATABASE}"
                    echo "ACTION        : ${params.ACTION}"
                    echo "NODE          : ${env.ROUTED_NODE}"
                    echo "OS            : ${env.ROUTED_OS}"
                    echo "PIPELINE PATH : ${env.ROUTED_PIPELINE}"
                }
            }
        }

        stage('Execute Routed Pipeline') {
            agent {
                label "${env.ROUTED_NODE}"
            }
            when {
                expression { currentBuild.number > 1 }
            }
            steps {
                checkout scm
                script {
                    def module = load env.ROUTED_PIPELINE

                    if (module == null) {
                        error("Unable to load routed pipeline module: ${env.ROUTED_PIPELINE}")
                    }

                    executePipeline(
                        env.ROUTED_DATABASE,
                        env.ROUTED_ACTION,
                        env.ROUTED_OS
                    ) {
                        def tracker = load 'jenkins/common/common_stage_tracker.groovy'
                        def context = [database: env.ROUTED_DATABASE, action: env.ROUTED_ACTION, operatingSystem: env.ROUTED_OS, node: env.ROUTED_NODE, cleanupMode: params.CLEANUP_MODE]
                        module.execute(context + [runTrackedStage: { String stageName, Closure stageBody -> tracker.track(context, stageName, stageBody) }])
                    }
                }
            }
        }
    }

    post {
        success {
            echo "MASTER DATABASE PIPELINE SUCCESSFUL: ${params.DATABASE} ${params.ACTION}"
        }
        failure {
            echo "MASTER DATABASE PIPELINE FAILED: ${params.DATABASE} ${params.ACTION}"
        }
        always {
            echo 'MASTER DATABASE PIPELINE COMPLETED'
        }
    }
}
